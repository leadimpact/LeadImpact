# Main domain — email addresses (info@, support@, admissions@ …) are built from it.
NEXT_PUBLIC_BASE_DOMAIN=leadimpactuniversity.education

# Public URL of each app (addendum v5: never hard-code a domain).
# Leave them unset locally: links then use internal paths on one host (localhost:3000/portal/…).
# Locally you can also try the subdomains at http://portal.localhost:3000, staff.localhost:3000 …
NEXT_PUBLIC_SITE_URL=https://leadimpactuniversity.education
NEXT_PUBLIC_ADMISSIONS_URL=https://admissions.leadimpactuniversity.education
NEXT_PUBLIC_PORTAL_URL=https://portal.leadimpactuniversity.education
NEXT_PUBLIC_STAFF_URL=https://staff.leadimpactuniversity.education
# LIU Learn is on hold (custom build vs Moodle); point this at whichever platform is chosen.
NEXT_PUBLIC_LEARN_URL=https://learn.leadimpactuniversity.education

# Show Kenya once LIU confirms the campus.
NEXT_PUBLIC_FEATURE_KENYA=false

# Cloudinary — every photo is served from here (src/content/media.ts).
# Vercel needs only the cloud name and folder; the key and secret are for `pnpm images:upload`.
# Without a cloud name, photos show as labelled placeholders.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_FOLDER=website
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
